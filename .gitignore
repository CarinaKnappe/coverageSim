# Analysis code IS tracked; only the data and vendored third-party code inside
# those folders is not. analysis/benchmarks/rust/upstream is a separate GPL-3 repository
# (JackCurragh/RUST) -- its exact commit is recorded in each run manifest, so it
# does not need to be redistributed here.
analysis/benchmarks/rust/upstream/
analysis/benchmarks/rust/.venv-rust-original/
choros/results/
choros/.Rhistory
__pycache__/
