# Run CHOROS on the prepared human-genome-only coverageSim sample.
source_file <- tryCatch(normalizePath(sys.frame(1)$ofile, mustWork = TRUE), error = function(e) NA_character_)
script_arg <- grep("^--file=", commandArgs(FALSE), value = TRUE)
script_dir <- if (!is.na(source_file)) dirname(source_file) else if (length(script_arg)) dirname(normalizePath(sub("^--file=", "", script_arg[1]))) else getwd()
source(file.path(script_dir, "choros_utils.R"))

library(data.table)
library(fixest)
library(ggplot2)
library(patchwork)

covsim_dir <- Sys.getenv("CHOROS_COVSIM_BASE", unset = "")
if (!nzchar(covsim_dir)) stop("Set CHOROS_COVSIM_BASE to the human_genome_only_v2 directory.")
covsim_dir <- normalizePath(covsim_dir, mustWork = TRUE)
output_dir <- Sys.getenv("CHOROS_COVSIM_OUTPUT_DIR", unset = file.path(covsim_dir, "choros_results"))
table_dir <- file.path(output_dir, "tables"); plot_dir <- file.path(output_dir, "figures")
dir.create(table_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(plot_dir, recursive = TRUE, showWarnings = FALSE)

run_id <- "RFP_WT_1"
prepared_file <- file.path(output_dir, "prepared", paste0(run_id, "_choros_input.rds"))
if (!file.exists(prepared_file)) stop("Prepared input is missing. Run prepare_choros_covsim_human_genome_only.R first:\n", prepared_file)
prepared <- readRDS(prepared_file)
required <- c("dt_obs", "tx_seqs", "off_long", "source_bam")
missing <- setdiff(required, names(prepared))
if (length(missing)) stop("Prepared input is missing: ", paste(missing, collapse = ", "))
dt_obs <- as.data.table(prepared$dt_obs); off_long <- as.data.table(prepared$off_long)
tx_seqs <- prepared$tx_seqs
message("Usable simulated read count: ", sum(dt_obs$count))

model_dt <- build_model_dt(dt_obs, tx_seqs, off_long)
res <- fit_choros(model_dt, tx_seqs, n_top_tx = 250L, min_prop = 0.90)
if (is.null(res)) stop("CHOROS model fitting returned NULL.")
bias_before <- eval_bias_norm(res$model_dt, tx_seqs, "count")
res$model_dt <- correct_bias_choros(res$model_dt, res$fit)
bias_after <- eval_bias_norm(res$model_dt, tx_seqs, "corrected")
absolute_bias <- compute_absolute_bias_score(res$model_dt)
dt_corrected <- apply_choros_bias_correction(dt_obs, tx_seqs, res$fit)

summary_dt <- data.table(
  run_id = run_id, dataset_type = "coverageSim_human_genome_only",
  input_bam = prepared$source_bam, total_reads = sum(dt_obs$count),
  training_transcripts = uniqueN(res$model_dt$transcript_id),
  BIC_base = res$BIC_base, BIC_full = res$BIC_full,
  selected_model = if (res$BIC_base <= res$BIC_full) "base" else "full",
  abs_5p_bias = absolute_bias$bias_5p_score,
  abs_3p_bias = absolute_bias$bias_3p_score,
  abs_total_bias = absolute_bias$total_bias_score
)
summary_file <- file.path(table_dir, paste0(run_id, "_choros_summary.csv"))
counts_file <- file.path(table_dir, paste0(run_id, "_choros_corrected_counts.csv.gz"))
fwrite(summary_dt, summary_file); fwrite(dt_corrected, counts_file)
combined_plot <- plot_diagnostics(dt_obs) /
  plot_bias_eval(bias_before, bias_after, paste(run_id, "coverageSim human-genome-only")) /
  plot_metagenes(dt_corrected)
pdf_file <- file.path(plot_dir, paste0(run_id, "_choros_diagnostics.pdf"))
ggsave(pdf_file, combined_plot, width = 14, height = 15, units = "in")
message("coverageSim CHOROS analysis completed.")
message("Summary: ", summary_file); message("Corrected counts: ", counts_file)
message("Diagnostics: ", pdf_file)
